PORT=3000
ADMIN_PASSWORD=choose-a-strong-password
DB_PATH=./crm.db
WEBSITE_ORIGIN=https://yourwebsite.com
META_VERIFY_TOKEN=any-random-string-you-invent
META_APP_SECRET=from Meta app > Settings > Basic
META_PAGE_TOKEN=long-lived Page access token
TELEGRAM_TOKEN=optional bot token from @BotFather
TELEGRAM_CHAT_ID=optional chat id for phone alerts
